{
  "name":    "@pulseway/db",
  "version": "1.0.0",
  "main":    "./dist/index.js",
  "types":   "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build":     "tsc --build",
    "clean":     "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --dry",
    "migrate":   "tsx src/migrate.ts",
    "test":      "vitest run"
  },
  "dependencies": {
    "@pulseway/config": "workspace:*",
    "@pulseway/types":  "workspace:*",
    "pg":               "^8.14.1",
    "pino":             "^9.7.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx":       "^4.19.4",
    "typescript": "^5.8.3",
    "vitest":    "^4.1.5"
  }
}
