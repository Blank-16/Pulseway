{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir":                           "./dist",
    "rootDir":                          "./src",
    "composite":                        true,
    "noUncheckedIndexedAccess":         true,
    "exactOptionalPropertyTypes":       true,
    "noImplicitOverride":               true,
    "noPropertyAccessFromIndexSignature": true
  },
  "references": [
    { "path": "../types" },
    { "path": "../config" },
    { "path": "../db" }
  ],
  "include":  ["src"],
  "exclude":  ["node_modules", "dist"]
}
