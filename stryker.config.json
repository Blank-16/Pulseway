{
  "$schema": "https://stryker-mutator.io/schemas/stryker-config/schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "packages/worker/src/IncidentEvaluator.ts",
    "packages/db/src/repositories/RefreshTokenRepository.ts",
    "packages/db/src/repositories/CheckResultBatcher.ts",
    "packages/api/src/services/MembershipCache.ts",
    "packages/api/src/middleware/rate-limiter.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".turbo"
  ]
}