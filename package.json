{
  "name": "pulseway",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "typecheck": "tsc --build --dry",
    "dev:api": "pnpm -C packages/api run dev",
    "dev:worker": "pnpm -C packages/worker run dev",
    "dev:scheduler": "pnpm -C packages/scheduler run dev",
    "dev:web": "pnpm -C apps/web run dev",
    "test": "vitest run",
    "test:integration": "docker compose -f tests/integration/docker-compose.test.yml up -d && sleep 3 && vitest run --config vitest.integration.config.ts",
    "test:integration:down": "docker compose -f tests/integration/docker-compose.test.yml down -v",
    "lint": "eslint packages apps --ext .ts,.tsx",
    "migrate": "pnpm -C packages/db run migrate",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}