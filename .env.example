# Database
DATABASE_URL=postgresql://pulseway:pulseway_dev@localhost:5432/pulseway

# Redis
REDIS_URL=redis://localhost:6379

# SQS (LocalStack in dev)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
CHECK_JOBS_QUEUE_URL=http://localhost:4566/000000000000/check-jobs
ALERT_JOBS_QUEUE_URL=http://localhost:4566/000000000000/alert-jobs

# Auth
JWT_SECRET=local-dev-secret-min-32-chars-long-here
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=7

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SES
SES_FROM_ADDRESS=alerts@pulseway.dev

# Service ports
API_PORT=4000
NODE_ENV=development

# Scheduler
SCHEDULER_POLL_INTERVAL_MS=10000

# Worker
WORKER_SQS_POLL_INTERVAL_MS=1000
WORKER_MAX_CONCURRENCY=10
# OpenTelemetry (optional — omit to disable tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=pulseway-api

# Incident detection
INCIDENT_CONSECUTIVE_FAILURES_REQUIRED=3

# Metrics endpoint auth (required in production, optional in dev)
METRICS_TOKEN=your-random-32-char-token-here

# Stripe price IDs from your Stripe dashboard
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_price_id
STRIPE_PRICE_TEAM_MONTHLY=price_your_team_price_id

# SSE connection cap per workspace (default 50)
SSE_MAX_CONNECTIONS_PER_WORKSPACE=50

# Your app's canonical origin (used to validate billing redirect URLs)
APP_ORIGIN=https://app.pulseway.dev

# Email verification (automatic on register)
# Ensure SES_FROM_ADDRESS is verified in AWS SES
# SES_FROM_ADDRESS=noreply@yourdomain.com

# Database connection pooling
DB_POOL_MAX=10
# Set to true when DATABASE_URL points at PgBouncer
PGBOUNCER=false

# Multi-region worker (set to the AWS region this process is deployed in)
WORKER_REGION=us-east-1

# JWT key rotation (set during rotation, remove after 15 minutes)
# JWT_SECRET_PREVIOUS=old-secret-here

# Azure deployment (set CLOUD=azure when running on Azure)
# CLOUD=azure
# AZURE_SERVICEBUS_CHECK_CONN_STR=Endpoint=sb://pulseway-staging-sb.servicebus.windows.net/;SharedAccessKeyName=worker-receive;SharedAccessKey=...
# AZURE_SERVICEBUS_ALERT_CONN_STR=Endpoint=sb://pulseway-staging-sb.servicebus.windows.net/;SharedAccessKeyName=worker-receive;SharedAccessKey=...
# AZURE_KEYVAULT_URI=https://pulseway-staging-kv.vault.azure.net/
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Azure email (required when CLOUD=azure — choose one)
# Option 1: Azure Communication Services
# AZURE_EMAIL_CONNECTION_STR=endpoint=https://pulseway.communication.azure.com/;accesskey=...
# Option 2: SendGrid (works on both clouds)
# SENDGRID_API_KEY=SG.xxx
